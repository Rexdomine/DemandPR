# Canonical production origin, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Indexing requires both this flag and VERCEL_ENV=production.
SITE_INDEXABLE=false

# Server-only contact delivery. Never prefix these values with NEXT_PUBLIC_.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=Demand PR Ltd
DEMANDPR_CONTACT_RECIPIENT=customercare@demandpr.org
