{
  "name": "demand-pr",
  "version": "0.1.0",
  "private": true,
  "description": "Demand PR Ltd public website",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:security": "node scripts/check-npm-audit.mjs",
    "verify:checkpoint": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "verify:diff": "node scripts/check-release-diff.mjs",
    "verify:release": "npm run audit:security && npm run verify:checkpoint && NEXT_TELEMETRY_DISABLED=1 NEXT_PUBLIC_SITE_URL=https://example.com SITE_INDEXABLE=false npm run build && npm run verify:diff"
  },
  "dependencies": {
    "next": "15.5.22",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.1.6",
    "@testing-library/user-event": "14.6.1",
    "@types/jest-axe": "3.5.9",
    "@types/node": "22.18.12",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jest-axe": "11.0.0",
    "jsdom": "27.2.0",
    "postcss": "8.5.26",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  },
  "overrides": {
    "postcss": "8.5.26",
    "nanoid": "3.3.17",
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.9"
    }
  }
}
